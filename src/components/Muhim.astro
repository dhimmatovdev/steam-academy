---
/**
 * Muhim — darsning asosiy g'oyasini ajratib ko'rsatadigan rangli blok.
 *
 * Uch turi bor va ular ataylab kam:
 *   gap  — darsning bitta katta g'oyasi (har darsda BITTA bo'lishi kerak)
 *   ogoh — tipik xato yoki xavfli joy
 *   sir  — kam odam biladigan qiziq fakt, diqqatni qaytaradi
 *
 * Starlight'ning <Aside> dan farqi: bu darsning ritmiga bog'langan
 * (bir dars = bir "gap") va blok rangi bilan emas, tur rangi bilan ishlaydi.
 */
interface Props {
	turi?: 'gap' | 'ogoh' | 'sir';
	/** Standart sarlavhani almashtirish */
	sarlavha?: string;
}

const { turi = 'gap', sarlavha } = Astro.props;

const TURLAR = {
	gap: { sarlavha: "Asosiy g'oya", belgi: '◆' },
	ogoh: { sarlavha: 'Bu yerda xato qilishadi', belgi: '▲' },
	sir: { sarlavha: 'Kam odam biladi', belgi: '★' },
} as const;

const ma = TURLAR[turi];
---

<aside class="muhim" data-turi={turi}>
	<p class="sarlavha">
		<span class="belgi" aria-hidden="true">{ma.belgi}</span>
		{sarlavha ?? ma.sarlavha}
	</p>
	<div class="ichi">
		<slot />
	</div>
</aside>

<style>
	.muhim {
		margin: 1.5rem 0;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--tur-chegara);
		border-left: 4px solid var(--tur-rang);
		border-radius: var(--sa-radius);
		background: var(--tur-fon);
	}

	.sarlavha {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0 0 0.4rem 0;
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--tur-rang);
	}

	.belgi {
		font-size: 0.8rem;
		line-height: 1;
	}

	.ichi {
		font-size: 1rem;
		line-height: 1.6;
	}

	.ichi :global(p:first-child) {
		margin-top: 0;
	}

	.ichi :global(p:last-child) {
		margin-bottom: 0;
	}

	/* "gap" darsning markaziy g'oyasi — shuning uchun accent rang.
	   Boshqalari 2- va 3-blok ranglaridan foydalanadi, yangi rang
	   kiritilmaydi (palitra tor qolsin). */
	.muhim[data-turi='gap'] {
		--tur-rang: var(--blok-1);
		--tur-fon: var(--blok-1-fon);
		--tur-chegara: var(--blok-1-chegara);
	}
	.muhim[data-turi='ogoh'] {
		--tur-rang: var(--blok-2);
		--tur-fon: var(--blok-2-fon);
		--tur-chegara: var(--blok-2-chegara);
	}
	.muhim[data-turi='sir'] {
		--tur-rang: var(--blok-3);
		--tur-fon: var(--blok-3-fon);
		--tur-chegara: var(--blok-3-chegara);
	}
</style>
