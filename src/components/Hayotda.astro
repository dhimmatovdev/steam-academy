---
/**
 * Hayotda — har darsning BIRINCHI bloki: bu mavzu hayotda qayerda kerak.
 *
 *   <Hayotda soha="Savdo">
 *     100 000 so'mni 7 kishiga bo'lish kerak...
 *   </Hayotda>
 *
 * Qoida: mavhum gap yo'q. "Programmalash muhim" deb YOZILMAYDI —
 * misolning o'zi ko'rsatadi. Misol mahalliy va aniq: do'kon hisobi,
 * sinf jurnali, transport, oylik xarajat.
 */
interface Props {
	/** Misol qaysi sohadan: "Savdo", "Maktab", "Transport"... */
	soha: string;
}

const { soha } = Astro.props;
---

<aside class="hayotda">
	<p class="bosh not-content">
		<span class="yorliq">Hayotda</span>
		<span class="soha">{soha}</span>
	</p>
	<div class="ichi">
		<slot />
	</div>
</aside>

<style>
	.hayotda {
		margin: 0 0 1.75rem 0;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--sa-radius);
		background: var(--sl-color-gray-7);
	}

	.bosh {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0 0 0.5rem 0;
	}

	.yorliq {
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--sl-color-accent);
	}

	.soha {
		padding: 0.1rem 0.55rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
	}

	.ichi {
		margin-top: 0;
		font-size: 1rem;
		line-height: 1.65;
	}

	.ichi :global(p:first-child) {
		margin-top: 0;
	}

	.ichi :global(p:last-child) {
		margin-bottom: 0;
	}
</style>
